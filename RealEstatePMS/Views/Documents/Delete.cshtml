@model Document
@{
    ViewData["Title"] = "Delete Document";
}

<h3 class="page-title mb-4 text-danger">Delete Document</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete this document? The file will be permanently removed.</p>
    <dl class="row">
        <dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Type</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
