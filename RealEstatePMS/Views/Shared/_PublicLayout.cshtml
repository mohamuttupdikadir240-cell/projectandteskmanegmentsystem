<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstate PMS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg public-navbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Public" asp-action="Index">
                <i class="bi bi-buildings-fill"></i> Real Estate PMS
            </a>
            <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#publicNavContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="publicNavContent">
                <ul class="navbar-nav me-auto ms-lg-4">
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Properties">Properties</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Index" asp-fragment="about">About</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Public" asp-action="Index" asp-fragment="contact">Contact</a></li>
                </ul>
                <div class="d-flex gap-2 mt-3 mt-lg-0">
                    <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        @RenderBody()
    </div>

    <footer class="public-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h6><i class="bi bi-buildings-fill"></i> Real Estate PMS</h6>
                    <p class="small mb-1">Project, sales, rental and payment management &mdash; all in one place.</p>
                    <p class="small mb-1"><i class="bi bi-telephone"></i> +252 61 000 0000</p>
                    <p class="small mb-0"><i class="bi bi-envelope"></i> info@realestate.com</p>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6>Quick Links</h6>
                    <a asp-controller="Public" asp-action="Index">Home</a>
                    <a asp-controller="Public" asp-action="Properties">Properties</a>
                    <a asp-controller="Public" asp-action="Index" asp-fragment="about">About</a>
                    <a asp-controller="Public" asp-action="Index" asp-fragment="contact">Contact</a>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6>Account</h6>
                    <a asp-controller="Account" asp-action="Login">Login</a>
                    <a asp-controller="Account" asp-action="Register">Register</a>
                </div>
            </div>
            <div class="footer-bottom text-center">
                &copy; @DateTime.Now.Year Real Estate PMS. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
