@model Customer
@{
    ViewData["Title"] = "Customer Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">@Model.Name</h3>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card content-card p-4">
            <dl class="row mb-0">
                <dt class="col-sm-5">Phone</dt><dd class="col-sm-7">@Model.Phone</dd>
                <dt class="col-sm-5">Email</dt><dd class="col-sm-7">@Model.Email</dd>
                <dt class="col-sm-5">Address</dt><dd class="col-sm-7">@Model.Address</dd>
                <dt class="col-sm-5">Nationality</dt><dd class="col-sm-7">@Model.Nationality</dd>
                <dt class="col-sm-5">ID Number</dt><dd class="col-sm-7">@Model.IdNumber</dd>
                <dt class="col-sm-5">Date of Birth</dt><dd class="col-sm-7">@Model.DateOfBirth?.ToString("MMM dd, yyyy")</dd>
                <dt class="col-sm-5">Registered</dt><dd class="col-sm-7">@Model.RegistrationDate.ToString("MMM dd, yyyy")</dd>
                <dt class="col-sm-5">Notes</dt><dd class="col-sm-7">@Model.Notes</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card content-card p-4 mb-3">
            <h6 class="fw-semibold mb-3">Sales</h6>
            <table class="table table-sm">
                <thead class="table-light"><tr><th>Property</th><th>Final Price</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Sales)
                    {
                        <tr>
                            <td>@s.Property?.Code</td>
                            <td>@s.FinalPrice.ToString("C0")</td>
                            <td><span class="badge @StatusBadge.Payment(s.PaymentStatus)">@s.PaymentStatus</span></td>
                        </tr>
                    }
                    @if (!Model.Sales.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-2">No sales.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card content-card p-4">
            <h6 class="fw-semibold mb-3">Rentals</h6>
            <table class="table table-sm">
                <thead class="table-light"><tr><th>Property</th><th>Monthly Rent</th><th>Contract Status</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rentals)
                    {
                        <tr>
                            <td>@r.Property?.Code</td>
                            <td>@r.MonthlyRent.ToString("C0")</td>
                            <td><span class="badge @StatusBadge.Contract(r.ContractStatus)">@r.ContractStatus</span></td>
                        </tr>
                    }
                    @if (!Model.Rentals.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-2">No rentals.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
