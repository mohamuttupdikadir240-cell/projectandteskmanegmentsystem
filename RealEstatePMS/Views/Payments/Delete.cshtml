@model Payment
@{
    ViewData["Title"] = "Delete Payment";
}

<h3 class="page-title mb-4 text-danger">Delete Payment</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete this payment? The related sale/rental balance will be recalculated.</p>
    <dl class="row">
        <dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Customer?.Name</dd>
        <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("C0")</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.PaymentDate.ToString("MMM dd, yyyy")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
