@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<h3 class="fw-bold mb-1">Check your request</h3>
<p class="text-muted mb-4">If an account with that email exists, a password reset link has been generated.</p>

@if (ViewBag.ResetLink != null)
{
    <div class="alert alert-info small">
        No email provider is configured for this demo, so here is your reset link:<br />
        <a href="@ViewBag.ResetLink">@ViewBag.ResetLink</a>
    </div>
}

<p class="text-center mt-4 small">
    <a asp-action="Login">Back to Login</a>
</p>
