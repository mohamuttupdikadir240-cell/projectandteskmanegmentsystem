@model NotificationSettingsViewModel
@{
    ViewData["Title"] = "Notification Settings";
}

<h3 class="page-title mb-2">Notification Settings</h3>
<p class="text-muted mb-4">Choose which alerts you want to receive, based on your role. Turning one off stops it from being generated for you - it won't affect other users.</p>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card content-card p-4">
            <form asp-action="NotificationSettings" method="post">
                @if (!Model.Items.Any())
                {
                    <p class="text-muted">There are no configurable notification types for your role.</p>
                }
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between align-items-start border-bottom py-3">
                        <div class="me-3">
                            <div class="fw-semibold">@item.Label</div>
                            <div class="text-muted small">@item.Description</div>
                        </div>
                        <div class="form-check form-switch flex-shrink-0">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   name="enabledTypes" value="@item.Type"
                                   checked="@(item.IsEnabled ? "checked" : null)" />
                        </div>
                    </div>
                }

                @if (Model.Items.Any())
                {
                    <button type="submit" class="btn btn-primary mt-4">Save Preferences</button>
                }
            </form>
        </div>
    </div>
</div>
