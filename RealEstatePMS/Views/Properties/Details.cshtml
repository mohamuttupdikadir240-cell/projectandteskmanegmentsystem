@model Property
@{
    ViewData["Title"] = "Property Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">@Model.Code</h3>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card content-card p-4 mb-3">
            @if (Model.Images.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var img in Model.Images)
                    {
                        <img src="@img.ImagePath" style="width:140px;height:110px;object-fit:cover;" class="rounded" />
                    }
                </div>
            }
            <div class="row g-3">
                <div class="col-md-4"><div class="text-muted small">Project</div><div class="fw-semibold">@Model.Project?.Name</div></div>
                <div class="col-md-4"><div class="text-muted small">Type</div><div class="fw-semibold">@Model.Type</div></div>
                <div class="col-md-4"><div class="text-muted small">Status</div><span class="badge @StatusBadge.Property(Model.Status)">@Model.Status</span></div>
                <div class="col-md-4"><div class="text-muted small">Building / Floor / Unit</div><div class="fw-semibold">@Model.Building / @Model.Floor / @Model.UnitNumber</div></div>
                <div class="col-md-4"><div class="text-muted small">Area</div><div class="fw-semibold">@Model.Area sqm</div></div>
                <div class="col-md-4"><div class="text-muted small">Bedrooms / Bathrooms</div><div class="fw-semibold">@Model.Bedrooms / @Model.Bathrooms</div></div>
                <div class="col-md-4"><div class="text-muted small">Price</div><div class="fw-semibold">@Model.Price.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Created</div><div class="fw-semibold">@Model.CreatedDate.ToString("MMM dd, yyyy")</div></div>
                <div class="col-12"><div class="text-muted small">Description</div><div>@Model.Description</div></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        @if (Model.Sale != null)
        {
            <div class="card content-card p-4 mb-3">
                <h6 class="fw-semibold mb-2">Sale Information</h6>
                <div class="small text-muted">Customer</div>
                <div class="fw-semibold mb-2">@Model.Sale.Customer?.Name</div>
                <div class="small text-muted">Final Price</div>
                <div class="fw-semibold mb-2">@Model.Sale.FinalPrice.ToString("C0")</div>
                <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.Sale.Id" class="btn btn-sm btn-outline-primary">View Sale</a>
            </div>
        }
        @if (Model.Rental != null)
        {
            <div class="card content-card p-4">
                <h6 class="fw-semibold mb-2">Rental Information</h6>
                <div class="small text-muted">Tenant</div>
                <div class="fw-semibold mb-2">@Model.Rental.Customer?.Name</div>
                <div class="small text-muted">Monthly Rent</div>
                <div class="fw-semibold mb-2">@Model.Rental.MonthlyRent.ToString("C0")</div>
                <a asp-controller="Rentals" asp-action="Details" asp-route-id="@Model.Rental.Id" class="btn btn-sm btn-outline-primary">View Rental</a>
            </div>
        }
    </div>
</div>
