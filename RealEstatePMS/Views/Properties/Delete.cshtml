@model Property
@{
    ViewData["Title"] = "Delete Property";
}

<h3 class="page-title mb-4 text-danger">Delete Property</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete the following property?</p>
    <dl class="row">
        <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.Code</dd>
        <dt class="col-sm-3">Project</dt><dd class="col-sm-9">@Model.Project?.Name</dd>
        <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Type</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @StatusBadge.Property(Model.Status)">@Model.Status</span></dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
