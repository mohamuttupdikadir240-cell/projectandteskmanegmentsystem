@model PaginatedList<Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Properties</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Property</a>
</div>

<div class="card content-card p-3">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search properties..." />
        </div>
        <div class="col-md-2">
            <select name="type" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()"><option value="">All Types</option></select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<PropertyStatus>()"><option value="">All Statuses</option></select>
        </div>
        <div class="col-md-3">
            <select name="projectId" class="form-select" asp-items="ViewBag.Projects"><option value="">All Projects</option></select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Image</th><th>Code</th><th>Project</th><th>Type</th><th>Price</th><th>Status</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var property in Model)
                {
                    var thumb = property.Images.FirstOrDefault()?.ImagePath;
                    <tr>
                        <td>
                            @if (thumb != null)
                            {
                                <img src="@thumb" class="property-thumb" alt="@property.Code" />
                            }
                            else
                            {
                                <div class="property-thumb bg-light d-flex align-items-center justify-content-center"><i class="bi bi-image text-muted"></i></div>
                            }
                        </td>
                        <td>@property.Code</td>
                        <td>@property.Project?.Name</td>
                        <td>@property.Type</td>
                        <td>@property.Price.ToString("C0")</td>
                        <td><span class="badge @StatusBadge.Property(property.Status)">@property.Status</span></td>
                        <td class="table-actions">
                            <a asp-action="Details" asp-route-id="@property.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@property.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No properties found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="@(new PaginationViewModel(Model.PageIndex, Model.TotalPages))" />
</div>
