@model Sale
@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Sale #@Model.Id</h3>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card content-card p-4">
            <div class="row g-3">
                <div class="col-md-4"><div class="text-muted small">Customer</div><div class="fw-semibold">@Model.Customer?.Name</div></div>
                <div class="col-md-4"><div class="text-muted small">Property</div><div class="fw-semibold">@Model.Property?.Code (@Model.Property?.Project?.Name)</div></div>
                <div class="col-md-4"><div class="text-muted small">Sales Agent</div><div class="fw-semibold">@Model.SalesAgent?.FullName</div></div>
                <div class="col-md-4"><div class="text-muted small">Sale Date</div><div class="fw-semibold">@Model.SaleDate.ToString("MMM dd, yyyy")</div></div>
                <div class="col-md-4"><div class="text-muted small">Total Price</div><div class="fw-semibold">@Model.TotalPrice.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Discount</div><div class="fw-semibold">@Model.Discount.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Final Price</div><div class="fw-semibold">@Model.FinalPrice.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Deposit</div><div class="fw-semibold">@Model.Deposit.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Remaining Balance</div><div class="fw-semibold">@Model.RemainingBalance.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Payment Status</div><span class="badge @StatusBadge.Payment(Model.PaymentStatus)">@Model.PaymentStatus</span></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card content-card p-4">
            <h6 class="fw-semibold mb-3">Payment History</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate))
                {
                    <li class="mb-2 border-bottom pb-2">
                        <div class="fw-semibold">@p.Amount.ToString("C0")</div>
                        <div class="small text-muted">@p.PaymentDate.ToString("MMM dd, yyyy") - @p.Method</div>
                    </li>
                }
                @if (!Model.Payments.Any())
                {
                    <li class="text-muted small">No payments recorded.</li>
                }
            </ul>
            <a asp-controller="Payments" asp-action="Create" asp-route-saleId="@Model.Id" class="btn btn-sm btn-primary mt-2">
                <i class="bi bi-plus-lg"></i> Record Payment
            </a>
        </div>
    </div>
</div>
