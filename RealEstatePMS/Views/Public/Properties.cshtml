@model PublicPropertiesViewModel
@{
    ViewData["Title"] = "Browse Properties";
    Layout = "_PublicLayout";
}

<h3 class="page-title mb-1">Browse Properties</h3>
<p class="text-muted mb-4">Check out our available and rented properties. Contact us for more details.</p>

<div class="card content-card p-3 mb-4">
    <form method="get" class="row g-2">
        <div class="col-md-10">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by code or unit..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Search</button>
        </div>
    </form>
</div>

<h5 class="fw-semibold mb-3"><i class="bi bi-house-check text-success"></i> Available Properties</h5>
<div class="row g-3 mb-5">
    @foreach (var property in Model.AvailableProperties)
    {
        var thumb = property.Images.FirstOrDefault()?.ImagePath;
        <div class="col-md-6 col-lg-4">
            <div class="card content-card h-100">
                @if (thumb != null)
                {
                    <img src="@thumb" class="card-img-top" style="height:180px;object-fit:cover;" alt="@property.Code" />
                }
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h6 class="fw-semibold mb-0">@property.Code</h6>
                        <span class="badge badge-soft-success">Available</span>
                    </div>
                    <div class="text-muted small mb-2">@property.Project?.Name &middot; @property.Project?.Location &middot; @property.Type</div>
                    <div class="small mb-2">
                        <i class="bi bi-rulers"></i> @property.Area sqm
                        @if (property.Bedrooms > 0) { <span class="ms-2"><i class="bi bi-door-closed"></i> @property.Bedrooms bd</span> }
                        @if (property.Bathrooms > 0) { <span class="ms-2"><i class="bi bi-droplet"></i> @property.Bathrooms ba</span> }
                    </div>
                    <div class="fs-5 fw-bold text-primary">@property.Price.ToString("C0")</div>
                </div>
            </div>
        </div>
    }
    @if (!Model.AvailableProperties.Any())
    {
        <div class="col-12">
            <div class="card content-card p-4 text-center text-muted">No available properties right now. Please check back later.</div>
        </div>
    }
</div>

<h5 class="fw-semibold mb-3"><i class="bi bi-house-lock text-secondary"></i> Rented Properties</h5>
<div class="row g-3 mb-5">
    @foreach (var property in Model.RentedProperties)
    {
        var thumb = property.Images.FirstOrDefault()?.ImagePath;
        <div class="col-md-6 col-lg-4">
            <div class="card content-card h-100">
                @if (thumb != null)
                {
                    <img src="@thumb" class="card-img-top" style="height:180px;object-fit:cover;" alt="@property.Code" />
                }
                <div class="p-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <h6 class="fw-semibold mb-0">@property.Code</h6>
                        <span class="badge badge-soft-secondary">Rented</span>
                    </div>
                    <div class="text-muted small mb-2">@property.Project?.Name &middot; @property.Project?.Location &middot; @property.Type</div>
                    <div class="small mb-2">
                        <i class="bi bi-rulers"></i> @property.Area sqm
                        @if (property.Bedrooms > 0) { <span class="ms-2"><i class="bi bi-door-closed"></i> @property.Bedrooms bd</span> }
                        @if (property.Bathrooms > 0) { <span class="ms-2"><i class="bi bi-droplet"></i> @property.Bathrooms ba</span> }
                    </div>
                    <div class="fs-5 fw-bold text-muted">@property.Price.ToString("C0")</div>
                </div>
            </div>
        </div>
    }
    @if (!Model.RentedProperties.Any())
    {
        <div class="col-12">
            <div class="card content-card p-4 text-center text-muted">No rented properties to show right now.</div>
        </div>
    }
</div>

<div class="card content-card p-4 text-center">
    <h6 class="fw-semibold mb-2">Interested in a property? Contact us</h6>
    <div class="d-flex justify-content-center gap-4 flex-wrap">
        <span><i class="bi bi-envelope text-primary"></i> info@realestate.com</span>
        <span><i class="bi bi-telephone text-primary"></i> +252 61 000 0000</span>
    </div>
</div>
