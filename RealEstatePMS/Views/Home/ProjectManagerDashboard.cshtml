@model ProjectManagerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="page-title mb-4">My Dashboard</h3>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Projects" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#3b6fd6;"><i class="bi bi-kanban"></i></div>
                    <div><div class="text-muted small">My Projects</div><div class="fs-4 fw-bold">@Model.MyProjectsCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Projects" asp-action="Index" asp-route-status="InProgress">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#1a9d5e;"><i class="bi bi-hourglass-split"></i></div>
                    <div><div class="text-muted small">Active</div><div class="fs-4 fw-bold">@Model.ActiveProjectsCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Projects" asp-action="Index" asp-route-status="Completed">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#8a5cf5;"><i class="bi bi-check2-circle"></i></div>
                    <div><div class="text-muted small">Completed</div><div class="fs-4 fw-bold">@Model.CompletedProjectsCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Projects" asp-action="Index" asp-route-status="OnHold">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#b8860b;"><i class="bi bi-pause-circle"></i></div>
                    <div><div class="text-muted small">On Hold</div><div class="fs-4 fw-bold">@Model.OnHoldProjectsCount</div></div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="ProjectTasks" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#1f7bb6;"><i class="bi bi-list-check"></i></div>
                    <div><div class="text-muted small">My Tasks</div><div class="fs-4 fw-bold">@Model.MyTasksCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="ProjectTasks" asp-action="Index" asp-route-status="Pending">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#666f80;"><i class="bi bi-clock"></i></div>
                    <div><div class="text-muted small">Pending</div><div class="fs-4 fw-bold">@Model.PendingTasksCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="ProjectTasks" asp-action="Index" asp-route-status="InProgress">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#1a9d5e;"><i class="bi bi-arrow-repeat"></i></div>
                    <div><div class="text-muted small">In Progress</div><div class="fs-4 fw-bold">@Model.InProgressTasksCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="ProjectTasks" asp-action="Index" asp-route-status="Delayed">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#d9463f;"><i class="bi bi-exclamation-triangle"></i></div>
                    <div><div class="text-muted small">Delayed</div><div class="fs-4 fw-bold">@Model.DelayedTasksCount</div></div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card content-card p-3 mb-3">
            <h6 class="fw-semibold mb-3">My Projects</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Project</th><th>Status</th><th>Progress</th><th>Properties</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.MyProjects)
                        {
                            <tr>
                                <td><a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                                <td><span class="badge @StatusBadge.Project(p.Status)">@p.Status</span></td>
                                <td style="min-width:120px;">
                                    <div class="progress" style="height:8px;"><div class="progress-bar" style="width:@p.ProgressPercentage%"></div></div>
                                </td>
                                <td>@p.NumberOfProperties</td>
                            </tr>
                        }
                        @if (!Model.MyProjects.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No projects assigned to you yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3 text-danger">Delayed Tasks</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Task</th><th>Project</th><th>Due Date</th><th>Assigned To</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.DelayedTasks)
                        {
                            <tr>
                                <td>@t.Name</td>
                                <td>@t.Project?.Name</td>
                                <td>@t.DueDate.ToString("MMM dd, yyyy")</td>
                                <td>@(t.AssignedEmployee?.FullName ?? "-")</td>
                            </tr>
                        }
                        @if (!Model.DelayedTasks.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No delayed tasks. Great job!</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card content-card p-3 mb-3">
            <h6 class="fw-semibold mb-3">Upcoming Tasks</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var t in Model.UpcomingTasks)
                {
                    <li class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
                        <div>
                            <div class="fw-semibold small">@t.Name</div>
                            <div class="text-muted small">@t.Project?.Name</div>
                        </div>
                        <div class="text-end">
                            <span class="badge @StatusBadge.Priority(t.Priority)">@t.Priority</span>
                            <div class="text-muted small mt-1">@t.DueDate.ToString("MMM dd")</div>
                        </div>
                    </li>
                }
                @if (!Model.UpcomingTasks.Any())
                {
                    <li class="text-muted small">No upcoming tasks.</li>
                }
            </ul>
        </div>

        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3">Recent Activity</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var activity in Model.RecentActivities)
                {
                    <li class="d-flex align-items-start gap-2 mb-3">
                        <i class="bi @activity.Icon @activity.ColorClass"></i>
                        <div>
                            <div class="small">@activity.Description</div>
                            <div class="text-muted" style="font-size:0.72rem;">@activity.Date.ToString("MMM dd, HH:mm")</div>
                        </div>
                    </li>
                }
                @if (!Model.RecentActivities.Any())
                {
                    <li class="text-muted small">No recent activity.</li>
                }
            </ul>
        </div>
    </div>
</div>
