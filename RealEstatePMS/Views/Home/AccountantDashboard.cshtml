@model AccountantDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="page-title mb-4">Finance Dashboard</h3>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Payments" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="text-muted small">Total Revenue</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalRevenue.ToString("C0")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">Revenue This Month</div>
            <div class="fs-4 fw-bold text-primary">@Model.RevenueThisMonth.ToString("C0")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Sales" asp-action="Index" asp-route-status="Partial">
            <div class="card stat-card p-3">
                <div class="text-muted small">Pending Sales Balance</div>
                <div class="fs-4 fw-bold text-danger">@Model.PendingSalesBalance.ToString("C0")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Rentals" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="text-muted small">Pending Rental Balance</div>
                <div class="fs-4 fw-bold text-danger">@Model.PendingRentalBalance.ToString("C0")</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#d9463f;"><i class="bi bi-exclamation-circle"></i></div>
                <div><div class="text-muted small">Outstanding Sales</div><div class="fs-4 fw-bold">@Model.OverdueSalesCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#b8860b;"><i class="bi bi-calendar-x"></i></div>
                <div><div class="text-muted small">Expired Rentals</div><div class="fs-4 fw-bold">@Model.OverdueRentalsCount</div></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3">Revenue Trend</h6>
            <canvas id="revenueChart" height="180"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3">Outstanding Sales</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Customer</th><th>Property</th><th>Remaining</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.OutstandingSales)
                        {
                            <tr>
                                <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@s.Id">@s.Customer?.Name</a></td>
                                <td>@s.Property?.Code</td>
                                <td class="text-danger fw-semibold">@s.RemainingBalance.ToString("C0")</td>
                            </tr>
                        }
                        @if (!Model.OutstandingSales.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No outstanding balances.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-12">
        <div class="card content-card p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-semibold mb-0">Recent Payments</h6>
                <a asp-controller="Payments" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Amount</th><th>Date</th><th>Method</th><th>Reference</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.RecentPayments)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Amount.ToString("C0")</td>
                                <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td>@p.Method</td>
                                <td>@p.ReferenceNumber</td>
                            </tr>
                        }
                        @if (!Model.RecentPayments.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('revenueChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartMonths)),
                datasets: [{ label: 'Revenue', data: @Html.Raw(Json.Serialize(Model.ChartRevenue)), borderColor: '#1a9d5e', backgroundColor: 'rgba(26,157,94,0.12)', fill: true, tension: 0.35 }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}
