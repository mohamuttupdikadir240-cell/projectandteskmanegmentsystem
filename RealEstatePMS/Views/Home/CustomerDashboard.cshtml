@model CustomerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="page-title mb-4">My Dashboard</h3>

@if (!Model.HasCustomerProfile)
{
    <div class="alert alert-warning">
        We couldn't find a customer profile linked to your account yet. Please contact our team for assistance.
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#3b6fd6;"><i class="bi bi-cash-coin"></i></div>
                    <div><div class="text-muted small">Active Sales</div><div class="fs-4 fw-bold">@Model.ActiveSalesCount</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#1f7bb6;"><i class="bi bi-key"></i></div>
                    <div><div class="text-muted small">Active Rentals</div><div class="fs-4 fw-bold">@Model.ActiveRentalsCount</div></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <a class="stat-card-link" asp-controller="BookingRequests" asp-action="MyBookings">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon" style="background:#b8860b;"><i class="bi bi-calendar-check"></i></div>
                        <div><div class="text-muted small">Pending Bookings</div><div class="fs-4 fw-bold">@Model.PendingBookingsCount</div></div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a class="stat-card-link" asp-controller="BookingRequests" asp-action="Catalog">
                <div class="card stat-card p-3 h-100 d-flex align-items-center justify-content-center text-center">
                    <i class="bi bi-house-door fs-3 text-primary mb-1"></i>
                    <div class="fw-semibold small">Browse Properties</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card stat-card p-3">
                <div class="text-muted small">Total Paid</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalPaid.ToString("C0")</div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card p-3">
                <div class="text-muted small">Total Outstanding</div>
                <div class="fs-4 fw-bold text-danger">@Model.TotalOutstanding.ToString("C0")</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card content-card p-3 mb-3">
                <h6 class="fw-semibold mb-3">My Purchases</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light"><tr><th>Property</th><th>Final Price</th><th>Remaining</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.MySales)
                            {
                                <tr>
                                    <td>@s.Property?.Code</td>
                                    <td>@s.FinalPrice.ToString("C0")</td>
                                    <td>@s.RemainingBalance.ToString("C0")</td>
                                    <td><span class="badge @StatusBadge.Payment(s.PaymentStatus)">@s.PaymentStatus</span></td>
                                </tr>
                            }
                            @if (!Model.MySales.Any())
                            {
                                <tr><td colspan="4" class="text-center text-muted py-3">No purchases yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card content-card p-3">
                <h6 class="fw-semibold mb-3">My Rentals</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light"><tr><th>Property</th><th>Monthly Rent</th><th>Contract</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.MyRentals)
                            {
                                <tr>
                                    <td>@r.Property?.Code</td>
                                    <td>@r.MonthlyRent.ToString("C0")</td>
                                    <td><span class="badge @StatusBadge.Contract(r.ContractStatus)">@r.ContractStatus</span></td>
                                </tr>
                            }
                            @if (!Model.MyRentals.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">No rentals yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card content-card p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-semibold mb-0">My Booking Requests</h6>
                    <a asp-controller="BookingRequests" asp-action="MyBookings" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead class="table-light"><tr><th>Property</th><th>Type</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var b in Model.MyBookings)
                            {
                                <tr>
                                    <td>@b.Property?.Code</td>
                                    <td>@(b.Type == BookingType.Purchase ? "Buy" : "Rent")</td>
                                    <td><span class="badge @StatusBadge.Booking(b.Status)">@b.Status</span></td>
                                </tr>
                            }
                            @if (!Model.MyBookings.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-3">No booking requests yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card content-card p-3">
                <h6 class="fw-semibold mb-3">Recent Payments</h6>
                <ul class="list-unstyled mb-0">
                    @foreach (var p in Model.RecentPayments)
                    {
                        <li class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="small">@p.PaymentDate.ToString("MMM dd, yyyy") &middot; @p.Method</span>
                            <span class="fw-semibold">@p.Amount.ToString("C0")</span>
                        </li>
                    }
                    @if (!Model.RecentPayments.Any())
                    {
                        <li class="text-muted small">No payments recorded yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
