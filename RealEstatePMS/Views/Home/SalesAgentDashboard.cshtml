@model SalesAgentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="page-title mb-4">My Dashboard</h3>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Sales" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#3b6fd6;"><i class="bi bi-cash-coin"></i></div>
                    <div><div class="text-muted small">My Sales</div><div class="fs-4 fw-bold">@Model.MySalesCount</div></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3">
            <div class="text-muted small">My Sales Total</div>
            <div class="fs-4 fw-bold text-primary">@Model.MySalesTotal.ToString("C0")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:#8a5cf5;"><i class="bi bi-people"></i></div>
                <div><div class="text-muted small">My Customers</div><div class="fs-4 fw-bold">@Model.MyCustomersCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a class="stat-card-link" asp-controller="Properties" asp-action="Index" asp-route-status="Available">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon" style="background:#1a9d5e;"><i class="bi bi-house-check"></i></div>
                    <div><div class="text-muted small">Available Properties</div><div class="fs-4 fw-bold">@Model.AvailablePropertiesCount</div></div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card p-3">
            <div class="text-muted small">Pending Balance (my sales)</div>
            <div class="fs-4 fw-bold text-danger">@Model.MyPendingBalanceTotal.ToString("C0")</div>
            <div class="text-muted small">@Model.MyPendingBalanceCount sale(s) with an outstanding balance</div>
        </div>
    </div>
    <div class="col-md-8">
        <a class="stat-card-link" asp-controller="BookingRequests" asp-action="Index">
            <div class="card stat-card p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Pending Booking Requests</div>
                        <div class="fs-4 fw-bold text-warning">@Model.PendingBookingRequestsCount</div>
                    </div>
                    <i class="bi bi-calendar-check fs-1 text-warning"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3">My Sales (last 6 months)</h6>
            <canvas id="mySalesChart" height="180"></canvas>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card content-card p-3 mb-3">
            <h6 class="fw-semibold mb-3">Recent Sales</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Customer</th><th>Property</th><th>Final Price</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.RecentSales)
                        {
                            <tr>
                                <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@s.Id">@s.Customer?.Name</a></td>
                                <td>@s.Property?.Code</td>
                                <td>@s.FinalPrice.ToString("C0")</td>
                                <td><span class="badge @StatusBadge.Payment(s.PaymentStatus)">@s.PaymentStatus</span></td>
                            </tr>
                        }
                        @if (!Model.RecentSales.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">You haven't recorded any sales yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card content-card p-3">
            <h6 class="fw-semibold mb-3">Pending Booking Requests</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Customer</th><th>Property</th><th>Type</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.PendingBookingRequests)
                        {
                            <tr>
                                <td>@b.Customer?.Name</td>
                                <td>@b.Property?.Code</td>
                                <td>@(b.Type == BookingType.Purchase ? "Buy" : "Rent")</td>
                                <td><a asp-controller="BookingRequests" asp-action="Index" class="btn btn-sm btn-outline-primary">Review</a></td>
                            </tr>
                        }
                        @if (!Model.PendingBookingRequests.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No pending requests.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('mySalesChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.ChartMonths)),
                datasets: [{ label: 'My Sales', data: @Html.Raw(Json.Serialize(Model.ChartMySales)), backgroundColor: '#3b6fd6' }]
            },
            options: { responsive: true, plugins: { legend: { display: false } } }
        });
    </script>
}
