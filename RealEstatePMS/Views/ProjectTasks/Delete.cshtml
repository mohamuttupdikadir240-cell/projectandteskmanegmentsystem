@model ProjectTask
@{
    ViewData["Title"] = "Delete Task";
}

<h3 class="page-title mb-4 text-danger">Delete Task</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete this task?</p>
    <dl class="row">
        <dt class="col-sm-3">Task</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Project</dt><dd class="col-sm-9">@Model.Project?.Name</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
