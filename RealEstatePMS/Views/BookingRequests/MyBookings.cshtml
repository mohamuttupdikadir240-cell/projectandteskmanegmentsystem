@model List<BookingRequest>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="page-title mb-0">My Bookings</h3>
    <a asp-action="Catalog" class="btn btn-primary"><i class="bi bi-house-door"></i> Browse Properties</a>
</div>

<div class="card content-card p-3">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light"><tr><th>Booking #</th><th>Property</th><th>Request Type</th><th>Your Offer</th><th>Payment Method</th><th>Requested</th><th>Status</th><th>Notes</th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="fw-semibold">@b.BookingNumber</td>
                        <td>@b.Property?.Code <span class="text-muted small">(@b.Property?.Project?.Name)</span></td>
                        <td>@(b.Type == BookingType.Purchase ? "Buy" : "Rent")</td>
                        <td>@(b.ProposedAmount.HasValue ? b.ProposedAmount.Value.ToString("C0") : "-")</td>
                        <td>@b.PreferredPaymentMethod</td>
                        <td>@b.RequestDate.ToString("MMM dd, yyyy")</td>
                        <td><span class="badge @StatusBadge.Booking(b.Status)">@b.Status</span></td>
                        <td class="small text-muted">@b.ReviewNotes</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">You haven't submitted any booking requests yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
