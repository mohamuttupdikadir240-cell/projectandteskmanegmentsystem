@model Project
@{
    ViewData["Title"] = "Delete Project";
}

<h3 class="page-title mb-4 text-danger">Delete Project</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete the following project? This action cannot be undone.</p>
    <dl class="row">
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.Code</dd>
        <dt class="col-sm-3">Location</dt><dd class="col-sm-9">@Model.Location</dd>
        <dt class="col-sm-3">Manager</dt><dd class="col-sm-9">@(Model.ProjectManager?.FullName ?? "Unassigned")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
