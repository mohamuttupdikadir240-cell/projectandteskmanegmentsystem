@model PaginatedList<Rental>
@{
    ViewData["Title"] = "Rental Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Rental Management</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Rental</a>
</div>

<div class="card content-card p-3">
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-6">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by customer or property..." />
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ContractStatus>()"><option value="">All Contract Statuses</option></select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light"><tr><th>Tenant</th><th>Property</th><th>Monthly Rent</th><th>Start</th><th>End</th><th>Payment</th><th>Contract</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var rental in Model)
                {
                    <tr>
                        <td>@rental.Customer?.Name</td>
                        <td>@rental.Property?.Code</td>
                        <td>@rental.MonthlyRent.ToString("C0")</td>
                        <td>@rental.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@rental.EndDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @StatusBadge.Payment(rental.PaymentStatus)">@rental.PaymentStatus</span></td>
                        <td><span class="badge @StatusBadge.Contract(rental.ContractStatus)">@rental.ContractStatus</span></td>
                        <td class="table-actions">
                            <a asp-action="Details" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No rentals found.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pagination" model="@(new PaginationViewModel(Model.PageIndex, Model.TotalPages))" />
</div>
