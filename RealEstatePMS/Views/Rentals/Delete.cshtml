@model Rental
@{
    ViewData["Title"] = "Delete Rental";
}

<h3 class="page-title mb-4 text-danger">Delete Rental</h3>

<div class="card form-card p-4">
    <p>Are you sure you want to delete this rental? The property will be released back to <strong>Available</strong> status and all related payments will be removed.</p>
    <dl class="row">
        <dt class="col-sm-3">Tenant</dt><dd class="col-sm-9">@Model.Customer?.Name</dd>
        <dt class="col-sm-3">Property</dt><dd class="col-sm-9">@Model.Property?.Code</dd>
        <dt class="col-sm-3">Monthly Rent</dt><dd class="col-sm-9">@Model.MonthlyRent.ToString("C0")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
