@model Rental
@{
    ViewData["Title"] = "Rental Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">Rental #@Model.Id</h3>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card content-card p-4">
            <div class="row g-3">
                <div class="col-md-4"><div class="text-muted small">Tenant</div><div class="fw-semibold">@Model.Customer?.Name</div></div>
                <div class="col-md-4"><div class="text-muted small">Property</div><div class="fw-semibold">@Model.Property?.Code (@Model.Property?.Project?.Name)</div></div>
                <div class="col-md-4"><div class="text-muted small">Monthly Rent</div><div class="fw-semibold">@Model.MonthlyRent.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Start Date</div><div class="fw-semibold">@Model.StartDate.ToString("MMM dd, yyyy")</div></div>
                <div class="col-md-4"><div class="text-muted small">End Date</div><div class="fw-semibold">@Model.EndDate.ToString("MMM dd, yyyy")</div></div>
                <div class="col-md-4"><div class="text-muted small">Deposit</div><div class="fw-semibold">@Model.Deposit.ToString("C0")</div></div>
                <div class="col-md-4"><div class="text-muted small">Payment Status</div><span class="badge @StatusBadge.Payment(Model.PaymentStatus)">@Model.PaymentStatus</span></div>
                <div class="col-md-4"><div class="text-muted small">Contract Status</div><span class="badge @StatusBadge.Contract(Model.ContractStatus)">@Model.ContractStatus</span></div>
                <div class="col-md-4"><div class="text-muted small">Total Paid</div><div class="fw-semibold text-success">@(((decimal)ViewBag.TotalPaid).ToString("C0"))</div></div>
                <div class="col-md-4">
                    <div class="text-muted small">Remaining Balance</div>
                    <div class="fw-semibold @(((decimal)ViewBag.RemainingBalance) > 0 ? "text-danger" : "text-success")">@(((decimal)ViewBag.RemainingBalance).ToString("C0"))</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Paid</div>
                    <div class="progress mt-1" style="height:8px;"><div class="progress-bar bg-success" style="width:@ViewBag.PaidPercentage%"></div></div>
                    <small class="text-muted">@ViewBag.PaidPercentage%</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card content-card p-4">
            <h6 class="fw-semibold mb-3">Payment History</h6>
            <ul class="list-unstyled mb-0">
                @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate))
                {
                    <li class="mb-2 border-bottom pb-2">
                        <div class="fw-semibold">@p.Amount.ToString("C0")</div>
                        <div class="small text-muted">@p.PaymentDate.ToString("MMM dd, yyyy") - @p.Method</div>
                    </li>
                }
                @if (!Model.Payments.Any())
                {
                    <li class="text-muted small">No payments recorded.</li>
                }
            </ul>
            <a asp-controller="Payments" asp-action="Create" asp-route-rentalId="@Model.Id" class="btn btn-sm btn-primary mt-2">
                <i class="bi bi-plus-lg"></i> Record Payment
            </a>
        </div>
    </div>
</div>
