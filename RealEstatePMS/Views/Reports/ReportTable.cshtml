@model ReportTableViewModel
@{
    ViewData["Title"] = ViewBag.ReportTitle;
    var filter = (ReportFilterViewModel)ViewBag.Filter;
    string actionName = ViewContext.RouteData.Values["action"]!.ToString()!;

    Func<string, string> exportUrl = (format) =>
    {
        var query = new Dictionary<string, Microsoft.Extensions.Primitives.StringValues>(Context.Request.Query);
        query["export"] = format;
        return Context.Request.Path + QueryString.Create(query);
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="page-title mb-0">@ViewBag.ReportTitle</h3>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Reports</a>
    </div>
</div>

<div class="card content-card p-3 mb-3">
    <form method="get" asp-action="@actionName">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small">Date Range (from)</label>
                <input type="date" name="StartDate" value="@(filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Date Range (to)</label>
                <input type="date" name="EndDate" value="@(filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Project</label>
                <select name="ProjectId" class="form-select form-select-sm" asp-items="ViewBag.Projects"><option value="">All Projects</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Property</label>
                <select name="PropertyId" class="form-select form-select-sm" asp-items="ViewBag.PropertiesList"><option value="">All Properties</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Customer</label>
                <select name="CustomerId" class="form-select form-select-sm" asp-items="ViewBag.Customers"><option value="">All Customers</option></select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Sales Agent</label>
                <select name="SalesAgentId" class="form-select form-select-sm" asp-items="ViewBag.Agents"><option value="">All Agents</option></select>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary btn-sm">Generate Report</button>
            <a href="@Url.Action(actionName)" class="btn btn-outline-secondary btn-sm">Reset</a>
            <a href="@exportUrl("pdf")" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf"></i> Export PDF</a>
            <a href="@exportUrl("excel")" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Export Excel</a>
        </div>
    </form>
</div>

<div class="card content-card p-3">
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted small">@Model.Rows.Count record(s) found</span>
        @if (ViewBag.Total != null)
        {
            <span class="fw-semibold">Total: @(ViewBag.Total is decimal d ? d.ToString("C0") : ViewBag.Total.ToString())</span>
        }
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr>
                    @foreach (var h in Model.Headers)
                    {
                        <th>@h</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>
                                @(cell is decimal dec ? dec.ToString("C0") : cell is DateTime dt ? dt.ToString("yyyy-MM-dd") : cell)
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="@Model.Headers.Length" class="text-center text-muted py-4">No records found for the selected filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
