@{
    ViewData["Title"] = "Reports";
}

<h3 class="page-title mb-4">Reports</h3>

<div class="row g-3">
    <div class="col-md-4 col-lg-3">
        <a asp-action="Sales" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-cash-coin fs-1 text-primary mb-2"></i>
                <h6 class="fw-semibold mb-0">Sales Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="Revenue" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-graph-up-arrow fs-1 text-success mb-2"></i>
                <h6 class="fw-semibold mb-0">Revenue Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="Properties" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-buildings fs-1 text-warning mb-2"></i>
                <h6 class="fw-semibold mb-0">Property Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="Customers" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-people fs-1 text-info mb-2"></i>
                <h6 class="fw-semibold mb-0">Customer Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="Payments" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-credit-card fs-1 text-danger mb-2"></i>
                <h6 class="fw-semibold mb-0">Payment Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="ProjectProgress" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-kanban fs-1 text-primary mb-2"></i>
                <h6 class="fw-semibold mb-0">Project Progress Report</h6>
            </div>
        </a>
    </div>
    <div class="col-md-4 col-lg-3">
        <a asp-action="Rentals" class="text-decoration-none">
            <div class="card content-card p-4 text-center h-100">
                <i class="bi bi-key fs-1 text-secondary mb-2"></i>
                <h6 class="fw-semibold mb-0">Rental Report</h6>
            </div>
        </a>
    </div>
</div>
