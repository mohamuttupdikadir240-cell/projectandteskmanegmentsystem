 =3D sale.CustomerId,</pre><pre><span style=3D'mso-spacerun:yes'>&nbsp;&nbs=
p;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>SaleId =3D =
sale.Id,</pre><pre><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp=
;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span>Amount =3D sale.Deposit,=
</pre><pre><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&=
