<p>The excerpt below, reproduced from Services/PaymentService.cs, shows how
recording or deleting a payment triggers automatic recalculation of the ass=
ociated
sale or rental balance, as described in Section 4.6.</p>

<div style=3D'mso-element:para-border-div;border:solid #B0B0B0 1.0pt;paddin=
g:
8.0pt 8.0pt 8.0pt 8.0pt;background:#F4F4F4'><pre>public async Task&lt;(bool=
 Success, string? Error)&gt; CreatePaymentAsync(Payment payment)</pre><pre>=
{</pre><pre><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp; </span>if (=
payment.SaleId =3D=3D null &amp;&amp; payment.RentalId =3D=3D null)</pre><p=
re><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nb=
sp; </span>return (false, &quot;A payment must be linked to a Sale or a Ren=
tal.&quot;);</pre><pre><o:p>&nbsp;</o:p></pre><pre><span style=3D'mso-space=
run:yes'>&nbsp;&nbsp;&nbsp; </span>_context.Payments.Add(payment);</pre><pr=
e><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp; </span>await _context=
.SaveChangesAsync();</pre><pre><o:p>&nbsp;</o:p></pre><pre><span style=3D'm=
so-spacerun:yes'>&nbsp;&nbsp;&nbsp; </span>if (payment.SaleId.HasValue)</pr=
e><pre><span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp=
;&nbsp; </span>await _salesService.RecalculatePaymentStatusAsync(payment.Sa=
leId.Value);</pre><pre><o:p>&nbsp;</o:p></pre><pre><span style=3D'mso-space=
run:yes'>&nbsp;&nbsp;&nbsp; </span>if (payment.RentalId.HasValue)</pre><pre=
> <span style=3D'mso-spacerun:yes'>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbs=
p;</span>await _rentalService.RecalculatePaymentStatusAsync(payment.RentalI=
d.Value);</pre><pre><o:p>&nbsp;</o:p></pre><pre><span style=3D'mso-spacerun=
:yes'>&nbsp;&nbsp;&nbsp; </span>return (true, null);</pre><pre
style=3D'background:#F4F4F4'>}</pre></div>

